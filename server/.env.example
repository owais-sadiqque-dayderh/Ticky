# Copy to server/.env and fill in. Never commit the filled-in copy.

PORT=8787
DATA_DIR=./data

# Where this server is reachable from a browser (https in production).
# config.js API_BASE becomes <PUBLIC_URL>/api.
PUBLIC_URL=https://api.example.com

# The registration site. YouPI sends people back here after they pay.
SITE_URL=https://ticky.example.com
# Extra origins allowed to call the API, comma-separated. Defaults to SITE_URL's.
# ALLOWED_ORIGINS=https://ticky.example.com,http://localhost:3000

# The door code staff type on /scan, /dash and /admin. At least 12 characters;
# ten wrong guesses from one address pause sign-in there for 15 minutes.
STAFF_KEY=CHANGE-ME-PLEASE
# Signs every entry QR. `openssl rand -hex 32`. Changing it voids issued tickets.
TICKET_SECRET=
# Ticket numbers look like TKY-7K3F-92QD.
TICKET_PREFIX=TKY

# YouPI PG payment API (port 6100 by default) and your merchant's credentials,
# both from the YouPI Merchant Admin panel.
YOUPI_API_URL=http://127.0.0.1:6100
YOUPI_MERCHANT_ID=
YOUPI_WEBHOOK_SECRET=

# Optional ticket email. Leave SMTP_URL empty to show tickets on screen only.
# SMTP_URL=smtps://user:app-password@smtp.example.com:465
# MAIL_FROM="Chicken Dinner <tickets@example.com>"

# Set to 1 only behind a reverse proxy / tunnel you run, so rate limits see real client IPs.
TRUST_PROXY=0
